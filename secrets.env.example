# FIDAA MCP server — environment example.
# Copy to secrets.env and fill in. The demo uses the same OpenAI-compatible
# API, so its secrets.env values work here unchanged.

# Required: OpenAI-compatible endpoint serving the embedding model.
LLM_URL=https://ai.h2.de/llm/v1
LLM_KEY=
EMBEDDING_MODEL=Qwen3-Embedding-4B

# Instruction-aware query embedding (demo parity: on by default).
USE_EMBED_INSTRUCTIONS=true
DEFAULT_TASK_INSTRUCTION=Given a web search query, retrieve relevant passages that answer the query

# HTTP mode only (stdio mode needs none of these).
MCP_HOST=0.0.0.0
MCP_PORT=8002
# Comma-separated Host allowlist for the SDK's 421 guard. In docker compose
# this must contain the service name (e.g. "localhost,127.0.0.1,fidaa").
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional bearer-token gate for the HTTP endpoint. Empty = open (the
# compose-internal default). Set this before exposing the endpoint publicly.
MCP_TOKEN=

# Optional third tool: folder of .md files indexed for search_documents.
# Empty (default) = tool not registered.
#DOCUMENTS_PATH=

# Log level (INFO default).
#LOG_LEVEL=INFO
