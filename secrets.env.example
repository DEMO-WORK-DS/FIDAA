# ── Secrets ──────────────────────────────────────────
# Copy this file to secrets.env and fill in your values.
# secrets.env is gitignored and dockerignored — never commit real secrets.
#
# After creating secrets.env, run:  docker compose up
# ──────────────────────────────────────────────────────

# LLM API key (required — the app will not start without this)
# LLM_URL=https://ai.mydomain.de/llm/v1
LLM_KEY=sk-your-key-here

# EMBEDDING_MODEL (optional)
# OpenAI-compatible endpoint for embeddings (must be reachable through VPN if LLM is VPN-restricted)
# EMBEDDING_MODEL=Qwen3-Embedding-4B

# USE_EMBED_INSTRUCTIONS (optional)
# Instruction-aware embeddings improve retrieval quality by 1-5%.
# Embeddings without this prefix are still valid, but instruction-aware embeddings are recommended.
# USE_EMBED_INSTRUCTIONS=true

# ── Optional overrides ───────────────────────────────
# Postgres password — must match DATABASE_URL if you change it.
# POSTGRES_PASSWORD=change-me

# JWT signing key — auto-generated at startup if unset.
# Set this to persist user sessions across container restarts.
# CHAINLIT_AUTH_SECRET=

# ── Seed users (optional) ───────────────────────────
# Comma-separated list of email:password pairs.
# Users are created/updated on every startup (idempotent).
# SEED_USERS=alice@example.com:secret123,bob@example.com:anotherpass

# ── VPN (optional) ──────────────────────────────────
# Only needed if the LLM API is behind a GlobalProtect VPN.
# The VPN sidecar runs OpenConnect and exposes a SOCKS5 proxy
# that the app uses for LLM API calls only.
#
# OPENCONNECT_URL=vpn.example.com
# OPENCONNECT_USER=user@example.com
# OPENCONNECT_PASSWORD=password
#
# VPN_ROUTES restricts which traffic enters the VPN tunnel.
# Only traffic to these subnets is routed through the VPN.
# To find the correct value:
#   1. Connect to the VPN manually
#   2. Run: ip route show table all | grep tun
#   3. Use the CIDR blocks shown, comma-separated
# Or resolve the LLM API hostname (e.g., `dig ai.mydomain.de`)
# and use the subnet that contains its IP (e.g., 0.0.0.0/16).
# VPN_ROUTES=0.0.0.0/16
#
# PROXY_URL is the SOCKS5 proxy address the app uses for LLM calls.
# When running with Docker Compose and the VPN sidecar, set to:
# PROXY_URL=socks5://vpn:8889
